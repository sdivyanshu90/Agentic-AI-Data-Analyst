{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase_outputs/phase7.json",
  "title": "Phase 7 Output — Data Visualisation & Dashboard Design",
  "type": "object",
  "required": [
    "phase",
    "phase_name",
    "status",
    "insight_to_chart_map",
    "dashboard_architecture",
    "visualisation_specs",
    "anti_pattern_audit",
    "accessibility_review",
    "narrative_flow",
    "phase_8_handoff"
  ],
  "properties": {
    "phase": { "const": 7 },
    "phase_name": { "type": "string" },
    "status": { "type": "string", "enum": ["COMPLETE", "NEEDS_RETRY"] },

    "insight_to_chart_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["insight_rank", "insight_summary", "chart_type", "chart_reasoning"],
        "properties": {
          "insight_rank": { "type": "integer", "minimum": 1 },
          "insight_summary": { "type": "string", "minLength": 1 },
          "chart_type": { "type": "string", "minLength": 1 },
          "chart_reasoning": { "type": "string", "minLength": 1 },
          "alternatives_rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chart", "reason_rejected"],
              "properties": {
                "chart": { "type": "string", "minLength": 1 },
                "reason_rejected": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },

    "dashboard_architecture": {
      "type": "object",
      "required": ["dashboard_type", "sections"],
      "properties": {
        "dashboard_type": {
          "type": "string",
          "enum": ["EXECUTIVE", "ANALYST", "OPERATIONAL"]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["section_name", "purpose", "components", "layout_position"],
            "properties": {
              "section_name": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "components": { "type": "array" },
              "layout_position": {
                "type": "string",
                "enum": ["top", "left", "center", "right", "bottom"]
              }
            }
          }
        },
        "interactivity_spec": { "type": "string" }
      }
    },

    "visualisation_specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chart_name", "purpose", "data_source", "x_axis", "alt_text"],
        "properties": {
          "chart_name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "chart_type": { "type": "string" },
          "data_source": {
            "type": "object",
            "required": ["table", "columns"],
            "properties": {
              "table": { "type": "string", "minLength": 1 },
              "columns": { "type": "array", "items": { "type": "string" } }
            }
          },
          "x_axis": {
            "type": "object",
            "required": ["field"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "format": { "type": "string" }
            }
          },
          "y_axis": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "format": { "type": "string" },
              "scale": { "type": "string" }
            }
          },
          "colour_encoding": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "palette": { "type": "string" },
              "colourblind_safe": { "type": "boolean" }
            }
          },
          "filters": { "type": "array" },
          "tooltips": { "type": "array" },
          "reference_lines": { "type": "array" },
          "annotations": { "type": "array" },
          "alt_text": { "type": "string", "minLength": 1 },
          "recommended_tool": { "type": "string" }
        }
      }
    },

    "anti_pattern_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chart_name", "anti_pattern_found", "correction_applied"],
        "properties": {
          "chart_name": { "type": "string", "minLength": 1 },
          "anti_pattern_found": { "type": "string", "minLength": 1 },
          "correction_applied": { "type": "string", "minLength": 1 }
        }
      }
    },

    "accessibility_review": {
      "type": "object",
      "required": [
        "colourblind_safe",
        "min_font_size_met",
        "alt_text_written",
        "wcag_contrast_met"
      ],
      "properties": {
        "colourblind_safe": { "type": "boolean" },
        "min_font_size_met": { "type": "boolean" },
        "alt_text_written": { "type": "boolean" },
        "wcag_contrast_met": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },

    "narrative_flow": {
      "type": "object",
      "required": ["hook", "payoff", "dashboard_section_order"],
      "properties": {
        "hook": { "type": "string", "minLength": 1 },
        "context_sequence": { "type": "array", "items": { "type": "string" } },
        "payoff": { "type": "string", "minLength": 1 },
        "dashboard_section_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "phase_8_handoff": {
      "type": "object",
      "required": ["chart_titles_as_insight_headlines", "narrative_arc_summary"],
      "properties": {
        "chart_titles_as_insight_headlines": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "narrative_arc_summary": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": true
}
