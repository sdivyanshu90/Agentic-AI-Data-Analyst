{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission_brief.json",
  "title": "Mission Brief",
  "type": "object",
  "required": ["mission_brief"],
  "properties": {
    "mission_brief": {
      "type": "object",
      "required": [
        "objective",
        "stakeholder_type",
        "data_source_description",
        "constraints",
        "success_looks_like",
        "assumptions"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "business_domain": { "type": "string" },
        "stakeholder_type": { "type": "string", "minLength": 1 },
        "data_source_description": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "object",
          "properties": {
            "time": { "type": "string" },
            "tools": { "type": "string" },
            "privacy": { "type": "string" }
          },
          "additionalProperties": true
        },
        "success_looks_like": { "type": "string" },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
